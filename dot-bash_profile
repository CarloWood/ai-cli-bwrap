if [ -n "$BASH_EXECUTION_STRING" ]; then
  # If BASH_EXECUTION_STRING is set then this is a user command run from opencode.
  # The environment should already be correct in this case (we use what is set when opencode was started).
  return 0
fi

AGENT="$AICLI_RUN_CLI"
[[ -n "$AGENT" ]] || AGENT="AICLI"
echo -e "Starting \e[31m$AGENT\e[0m environment (\e[32m$AICLI_MODE\e[0m)."

export WORKSPACE_ROOT=$HOME/workspace
export HOME_AICLI=$HOME

# Set up the CDEH environment.
CDEH_ROOT=$HOME/cdeh
source $CDEH_ROOT/env.bashrc

# Load the host base environment. The CDEH_ROOT was abused to store that.
source "$CDEH_ROOT/env.base"

# Change the base environment.
export AICLI_INSIDE_ENVIRONMENT=1
export WORKSPACE_ROOT=$HOME/workspace
# Default top project for compiling libraries.
export TOPPROJECT=$WORKSPACE_ROOT
# The current project.
export REPOROOT="$WORKSPACE_ROOT/$REPOBASE"
export PLANROOT="$WORKSPACE_ROOT/$REPOBASE-AAP"
# Set a CLI environment specific PATH.
export PATH="$HOME/.local/bin:/usr/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl"
# Set a CLI environment specific xdg cache directory.
export XDG_CACHE_HOME="$WORKSPACE_ROOT/cache/xdg"
# We want to use the same db name when running inside the opencode project, even though
# in that case that is run using `bun run`.
export OPENCODE_DISABLE_CHANNEL_DB=1
# Can't download debuginfo?
unset DEBUGINFOD_URLS
# Need to export *everything* :(
export CDEH_ROOT

if [ "$AICLI_MODE" = "shell" ]; then
  #------------------------------------------------------------------------------
  # These are set for convenience, while using this environment myself.
  export PASSWORD_STORE_X_SELECTION=primary
  export PASSWORD_STORE_CLIP_TIME=15
  eval `dircolors $HOME/.DIR_COLORS`
  # Aliases
  alias vi="vim"
  alias ls='ls --file-type --group-directories-first --color=auto'

  # Set a fancy color prompt
  PS1PREFIX="$HOSTNAME-\[\e[31m\]ai-cli\[\e[0m\]:"
  PS1=$PS1PREFIX'\[\e[35m\]\w\[\e[32`if [[ ${EUID} == 0 ]]; then echo ";7"; fi`m\]>\[\e[30;47;0m\]'
  #------------------------------------------------------------------------------
else
  # Clear things we don't want and set things we do.
  unset PROMPT_COMMAND
  export HISTFILE="$CDEH_HISTROOT$WORKSPACE_ROOT/history"
  PS1="ai-cli-\w>"
  unalias ssh 2>/dev/null
fi

# Load aap-* functions.
source $PLANROOT/agents-common/bash/aap.bash

# Store this as the base environment.
__cdeh_store_environment

# Put it all together.
resource

# Support for aap-configure.
export AAP_BUILD_TYPE="${CMAKE_CONFIG:-Debug}"
export AAP_GENERATOR="Ninja"

# Export abbreviate_path, because the AI needs it and opencode only provides it with exported stuff :/.
declare -xf abbreviate_path
declare -xf which
declare -xf findsymbol
declare -xf change_config
