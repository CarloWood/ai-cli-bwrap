import gdb, os

class SourceExpanded(gdb.Command):
    """Like 'source', but expands $VARIABLES and ~ in the file name."""
    def __init__(self):
        super().__init__("esource", gdb.COMMAND_SUPPORT, gdb.COMPLETE_FILENAME)

    def invoke(self, arg, from_tty):
        path = os.path.expanduser(os.path.expandvars(arg.strip()))
        gdb.execute(f"source {path}", from_tty)

SourceExpanded()
end

