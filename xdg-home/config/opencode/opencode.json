{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  "model": "zai-coding-plan/glm-5.2",
  "permission": {
    "bash": {
      "*": "allow",
      "bash -n *": "allow",
      "aap-*": "deny",
      "atl-*": "deny",
      "ctx7 *": "deny",
      "npx *": "deny"
    },
    "read": {
      "**": "allow",
      "{env:WORKSPACE_ROOT}/**": "allow",
      "{env:WORKSPACE_ROOT}/.xdg/**": "allow"
    },
    "edit": {
      "*": "deny"
    },
    "external_directory": {
      "{env:WORKSPACE_ROOT}/**": "allow",
      "{env:WORKSPACE_ROOT}/.xdg/**": "allow",
      "{env:GITACHE_ROOT}/**": "deny",
      "/usr/include/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "docs": {
      "disable": true
    },
    "analyst": {
      "description": "Pre-planning agent that can read PLANROOT and REPOROOT, do web searches.",
      "mode": "primary",
      "prompt": "{file:./prompts/analyst.txt}",
      "color": "#4040ff",
      "permission": {
        "bash": {
          "atl-list *": "allow",
          "atl-show *": "allow",
          "aap-ls *": "allow"
        }
      }
    },
    "planner": {
      "description": "Planning agent that reads REPOROOT, writes plans under PLANROOT. Treat REPOROOT as read-only.",
      "mode": "primary",
      "prompt": "{file:./prompts/planner.txt}",
      "color": "warning",
      "permission": {
        "bash": {
          "aap-*": "allow",
          "atl-list *": "allow",
          "atl-show *": "allow"
        },
        "edit": {
          "**/*": "allow"
        }
      }
    },
    "coder": {
      "description": "Default coding agent for implementation work in REPOROOT. Treat PLANROOT as read-only plan context.",
      "mode": "primary",
      "prompt": "{file:./prompts/coder.txt}",
      "color": "info",
      "permission": {
        "bash": {
          "aap-ls *": "allow",
          "aap-configure *": "allow",
          "aap-build *": "allow",
          "aap-test *": "allow",
          "aap-done *": "ask",
          "aap-previous *": "ask",
          "atl-list *": "allow",
          "atl-show *": "allow"
        },
        "edit": {
          "**/*": "allow"
        }
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  }
}
