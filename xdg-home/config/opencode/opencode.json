{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  "model": "zai-coding-plan/glm-5.2",
  "permission": {
    "bash": {
      "*": "ask",
      "bash -n *": "allow",
      "aap-*": "deny",
      "atl-*": "deny",
      "ctx7 *": "deny",
      "npx *": "deny",

      "archrelease *": "allow",
      "base32 *": "allow",
      "base64 *": "allow",
      "basename * *": "allow",
      "blkid *": "allow",
      "bscalc *": "allow",
      "bsdcat *": "allow",
      "bsdcpio *": "allow",
      "bsdtar *": "allow",
      "bsdunzip *": "allow",
      "bun run typecheck": "allow",
      "bun run --cwd * typecheck": "allow",
      "busctl *": "allow",
      "bzcat *": "allow",
      "bzdiff *": "allow",
      "bzgrep *": "allow",
      "bzip2 *": "allow",
      "bzmore *": "allow",
      "bzz *": "allow",
      "cairo-trace *": "allow",
      "catman * *": "allow",
      "c++filt *": "allow",
      "cmp *": "allow",
      "command -v *": "allow",
      "compgen *": "allow",
      "count *": "allow",
      "cp *": "allow",
      "cpio *": "allow",
      "ctags *": "allow",
      "cut *": "allow",
      "date *": "allow",
      "dd *": "allow",
      "declare -F": "allow",
      "df *": "allow",
      "diff *": "allow",
      "diff3 *": "allow",
      "dig *": "allow",
      "dir *": "allow",
      "dirname *": "allow",
      "dltest *": "allow",
      "dot *": "allow",
      "doxygen *": "allow",
      "dpipe *": "allow",
      "drill *": "allow",
      "du *": "allow",
      "dwarfdump *": "allow",
      "env * *": "allow",
      "errno *": "allow",
      "expr *": "allow",
      "factor *": "allow",
      "false": "allow",
      "file *": "allow",
      "filecap *": "allow",
      "flex *": "allow",
      "flex++ *": "allow",
      "fmt *": "allow",
      "free": "allow",
      "funzip *": "allow",
      "fy-* *": "allow",
      "gawk *": "allow",
      "getcap *": "allow",
      "getfacl *": "allow",
      "getfattr *": "allow",
      "getopt *": "allow",
      "glow *": "allow",
      "glxinfo *": "allow",
      "gm *": "allow",
      "gml2gv *": "allow",
      "gv2gml *": "allow",
      "groups": "allow",
      "gum *": "allow",
      "gunzip *": "allow",
      "gzip *": "allow",
      "hunspell *": "allow",
      "hzip *": "allow",
      "id *": "allow",
      "ident *": "allow",
      "iconv *": "allow",
      "info *": "allow",
      "infocmp *": "allow",
      "infotocap *": "allow",
      "inotifywait *": "allow",
      "inotifywatch *": "allow",
      "install *": "allow",
      "ip *": "allow",
      "join *": "allow",

      "hexdump *": "allow",
      "journalctl *": "allow",
      "jq *": "allow",
      "json*": "allow",
      "awk *": "allow",
      "cat *": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "readelf *": "allow",
      "eu-readelf *": "allow",
      "false": "allow",
      "find *": "allow",
      "findname *": "allow",
      "findsymbol *": "allow",
      "git *": "allow",
      "grep *": "allow",
      "gs *": "allow",
      "head": "allow",
      "ln *": "allow",
      "llvm-dwarfdump *": "allow",
      "ls *": "allow",
      "man *": "allow",
      "nl *": "allow",
      "nm *": "allow",
      "node --check *": "allow",
      "objdump *": "allow",
      "perl *": "allow",
      "pgrep *": "allow",
      "printenv *": "allow",
      "printf *": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "readlink *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "set *": "allow",
      "sleep *": "allow",
      "strace *": "allow",
      "tail *": "allow",
      "test *": "allow",
      "trap *": "allow",
      "true *": "allow",
      "type *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "zcat *": "allow"
    },
    "read": {
      "**": "allow",
      "{env:WORKSPACE_ROOT}/**": "allow",
      "{env:WORKSPACE_ROOT}/.xdg/**": "allow"
    },
    "edit": {
      "*": "deny"
    },
    "external_directory": {
      "{env:WORKSPACE_ROOT}/**": "allow",
      "{env:WORKSPACE_ROOT}/.xdg/**": "allow",
      "{env:GITACHE_ROOT}/**": "deny",
      "/usr/include/**": "allow"
    }
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "docs": {
      "disable": true
    },
    "analyst": {
      "description": "Pre-planning agent that can read PLANROOT and REPOROOT, do web searches.",
      "mode": "primary",
      "prompt": "{file:./prompts/analyst.txt}",
      "color": "#4040ff",
      "permission": {
        "bash": {
          "atl-list *": "allow",
          "atl-show *": "allow",
          "aap-ls *": "allow"
        }
      }
    },
    "planner": {
      "description": "Planning agent that reads REPOROOT, writes plans under PLANROOT. Treat REPOROOT as read-only.",
      "mode": "primary",
      "prompt": "{file:./prompts/planner.txt}",
      "color": "warning",
      "permission": {
        "bash": {
          "aap-*": "allow",
          "atl-list *": "allow",
          "atl-show *": "allow"
        },
        "edit": {
          "**/*": "allow"
        }
      }
    },
    "coder": {
      "description": "Default coding agent for implementation work in REPOROOT. Treat PLANROOT as read-only plan context.",
      "mode": "primary",
      "prompt": "{file:./prompts/coder.txt}",
      "color": "info",
      "permission": {
        "bash": {
          "aap-ls *": "allow",
          "aap-configure *": "allow",
          "aap-build *": "allow",
          "aap-test *": "allow",
          "aap-done *": "ask",
          "aap-previous *": "ask",
          "atl-list *": "allow",
          "atl-show *": "allow",
          "as *": "allow",
          "autogen.sh": "allow",
          "bash -c *": "allow",
          "c++ *": "allow",
          "cc *": "allow",
          "ccache *": "allow",
          "clang *": "allow",
          "clang++ *": "allow",
          "clang-format *": "allow",
          "cargo *": "allow",
          "cmake *": "allow",
          "configure": "allow",
          "ctest *": "allow",
          "gcc *": "allow",
          "gdb *": "allow",
          "g++ *": "allow",
          "git *": "allow",
          "just *": "allow",
          "make *": "allow",
          "mkdir *": "allow",
          "mktemp *": "allow",
          "ninja *": "allow",
          "node *": "allow",
          "rm *": "allow",
          "script *": "allow",
          "unifdef *": "allow"
        },
        "edit": {
          "**/*": "allow"
        }
      }
    }
  },
  "experimental": {
    "disable_paste_summary": true
  }
}
