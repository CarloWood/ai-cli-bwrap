WORKSPACE_ROOT="$HOME/projects/github/codex"
REPOBASE="codex-bwrap"

# Set up a default project environment.
project_environment

# Change default current working directory for Codex.
export CODEX_DIRECTORY=
# Cause sockettapd to actually write debug output.
export LIBCWD_RCFILE_OVERRIDE_NAME="$HOME/projects/aicxx/codex-sockettapd/libcwdrc_codex-sockettapd"

unset BUILDDIR
del_path "$CARGO_HOME/bin"
unset CARGO_HOME
unset CODEX_EXTRA_WRITABLE_ROOTS=

function gc()
{
  ( cd "$REPOROOT" &&
    find . \( -path './xdg-root/cache' -o -path './xdg-root/data' \
      -o -name '.git' -o -name 'model-input.jsonl' -o -name 'model-request.json' -o -name 'prompt-history.jsonl' \) -prune \
      -o -type f -print0 | xargs -0 grep -E -Hn "$@" )
}

function s()
{
  find $REPOROOT -name target -prune -o -type f -name "*.rs" -print
}

function make ()
{
  echo "Nothing to make"
}
