WORKSPACE_ROOT="$HOME/projects/github/ai-cli"
REPOBASE="ai-cli-bwrap"

# Set up a default project environment.
project_environment

# Change default current working directory for Codex.
export CODEX_DIRECTORY=
# Cause sockettapd to actually write debug output.
export LIBCWD_RCFILE_OVERRIDE_NAME="$HOME/projects/github/ai-cli/ai-cli-sockettapd/libcwdrc_ai-cli-sockettapd"

unset BUILDDIR

# Search all project files for a given pattern, skipping known generated files.
function gc()
{
  ( cd "$REPOROOT" &&
    find . \( -path './xdg-home/cache' -o -path './xdg-home/data' -o -name 'node_modules' \
      -o -name '.git' -o -name 'model-input.jsonl' -o -name 'model-request.json' -o -name 'topic-list-message.jsonl' -o -name 'prompt-history.jsonl' -o -name 'session_id.log' \) -prune \
      -o -type f -print0 | xargs -0 grep -E -Hn "$@" )
}

function configure()
{
  echo "Nothing to configure"
}

function make ()
{
  echo "Nothing to make"
}
