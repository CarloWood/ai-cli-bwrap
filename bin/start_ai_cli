#!/bin/bash -l

echo "Running: start_ai_cli $@"
echo "REPOROOT=\"$REPOROOT\", PLANROOT=\"$PLANROOT\", BUILDDIR=\"$BUILDDIR\", PWD=\"$PWD\""
echo "AVA_DEBUG_TERMINAL=\"$AVA_DEBUG_TERMINAL\""
echo "LIBCWD_RCFILE_OVERRIDE_NAME=\"$LIBCWD_RCFILE_OVERRIDE_NAME\""
echo "HOME=$HOME, .bash_profile exists: $(test -f "$HOME/.bash_profile" && echo yes || echo no)"

if [[ -z "$AICLI_INSIDE_ENVIRONMENT" ]]; then
  echo "start_ai_cli: ERROR: must be run inside netns nsaicli."
  exit 1
fi

function test_s_alias {
  shopt -s expand_aliases
  if [[ $(type -t s) == "alias" ]]; then
    return 0
  fi
  return 1
}

if test_s_alias; then
  echo -e "\e[31mWARNING\e[0m: s is an alias ; it should be a bash function.";
  sleep 1
fi

HAVE_MAKE_FUNCTION="$(type -t make)"
HAVE_S_FUNCTION="$(type -t s)"
HAVE_GS_FUNCTION="$(type -t gs)"
S_FUNCTION_USES_PRINT0=

if [[ $HAVE_S_FUNCTION == "function" ]]; then
  if (which prs || which s) | grep -- '-print0' >/dev/null; then
    S_FUNCTION_USES_PRINT0=yes
  fi
fi

if [[ $AICLI_RUN_CLI == "claude" ]]; then
  # Claude Code doesn't read a user-level AGENTS.md; its user-level instructions file is $CLAUDE_CONFIG_DIR/CLAUDE.md.
  if [[ -z "$CLAUDE_CONFIG_DIR" ]]; then
    echo "start_ai_cli: ERROR: CLAUDE_CONFIG_DIR isn't set."
    exit 1
  fi
  AGENTS_FILE="$CLAUDE_CONFIG_DIR/CLAUDE.md"
elif [[ -n $AICLI_RUN_CLI ]]; then
  if [[ -z "$XDG_CONFIG_HOME" ]]; then
    echo "start_ai_cli: ERROR: XDG_CONFIG_HOME isn't set."
    exit 1
  fi
  AGENTS_FILE="$XDG_CONFIG_HOME/$AICLI_RUN_CLI/AGENTS.md"
else
  AGENTS_FILE="$HOME/.codex/AGENTS.md"
fi

function fail {
  echo "$1"
  exit 1
}

# Regenerate $XDG_CONFIG_HOME/opencode/AGENTS.md.
$HOME/.local/bin/AGENTS.sh "$HAVE_MAKE_FUNCTION" "$HAVE_S_FUNCTION" "$HAVE_GS_FUNCTION" "$S_FUNCTION_USES_PRINT0" > $AGENTS_FILE || fail "Failed to create AGENTS.md file"

if [[ $HAVE_MAKE_FUNCTION = "function" ]]; then
  # Regenerate $CTAGS_FILE
  make ctags
fi

# Start a WM.
echo "DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY"
# Its output goes to a log instead of the terminal that the CLI is about to take over; /tmp is private to this sandbox.
# Expect "Failed to read: session.*" lines (init only holds a few settings) and fbsetbg complaining that it can't
# record ~/.fluxbox/lastwallpaper (read-only $HOME); both are harmless.
fluxbox >/tmp/fluxbox.log 2>&1 &

# Run the command that was passed to `start_ai_cli`.
# Usually that is `claude ...args...`, `opencode ...args...` or `ava ...args...`
# but it can also be `true` if the objective was to just (re)generate $XDG_CONFIG_HOME/opencode/AGENTS.md.
exec "$@"
