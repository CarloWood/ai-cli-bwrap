# This file must be sourced (with the full environment, including aliases, intact).
# Use the alias `ai_cli` to use it.

# Run sockettapd from its project directory.
pre_path "/home/carlo/projects/aicxx/codex-sockettapd/build/src"

# Sanity checks.
if [ -z "$WORKSPACE_ROOT" ]; then
  echo "Error: WORKSPACE_ROOT not set."
  exit 1
fi
if [ "$REPOROOT" != "$WORKSPACE_ROOT/$REPOBASE" ]; then
  echo "Error: REPOROOT != WORKSPACE_ROOT/REPOBASE"
  exit 1
fi
if [ -z "$CCACHE_DIR" ]; then
  echo "Error: CCACHE_DIR not set."
  exit 1
fi
if [[ $(type -t pe) != "function" ]]; then
  echo "Error: no such function: pe"
  exit 1
fi
if [[ ! -f "$CDEH_TMP/env.base" ]]; then
  echo "Error: $CDEH_TMP/env.base does not exist?!"
  exit 1
fi
if [[ ! -d "/run/remountd" ]]; then
  echo "Error: /run/remountd does not exist. Run `systemctl enable --now remountd.socket`."
  exit 1
fi
if [[ "$HOME_AICLI" != "/opt/ext4/nvme2/codex" ]]; then
  echo "HOME_AICLI has an unexpected value."
  exit 1
fi
if [ -z "$LIBCWD_RCFILE_OVERRIDE_NAME" ]; then
  # This is just a sanity check to make sure that sockettapd will write debug output.
  echo "Error: LIBCWD_RCFILE_OVERRIDE_NAME not set."
  exit 1
fi

# This is the directory that is bind mounted in the container as ~/workspace/.xdg.
AICLI_XDG_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/xdg-root"
echo "AICLI_XDG_ROOT=\"$AICLI_XDG_ROOT\""

realpath_nolast ()
{
  # Expand all symlinks but not that of the basename if it is one.
  printf '%s/%s\n' "$(realpath "$(dirname -- "$1")")" "$(basename -- "$1")"
}

function __cdeh_restore_host_environment()
{
  # Store the base environment to $WORKSPACE_ROOT/env.base.
  cp "$CDEH_TMP/env.base" "$HOME_AICLI/cdeh/env.base" 
  # Accumulate env.source files on top of this base that are not part of the bwrap environment (aka, WORKSPACE_ROOT).
  echo "# Host env.source files not part of this container." > "$HOME_AICLI/env.source"
  # This is the same as the first part of `resource`. It builds CDEH_ENVFILES.
  __cdeh_rebuild_source_dirs
  rm -f "$CDEH_TMP/envfiles"
  __cdeh_rebuild_envfiles
  local cdeh_envfiles=$(cat "$CDEH_TMP/envfiles")
  # Finally do the same thing as the part of resource: __cdeh_resource, but without actually sourcing or reset our own environment.
  local workspace_realpath=$(realpath "$WORKSPACE_ROOT")
  local CDEH_SAVE_IFS="$IFS"
  IFS='
  ';
  local nr=0
  for __cdeh_env_file in $cdeh_envfiles;
  do
    if test "$__cdeh_env_file" != "__cdeh_reset_environment"; then
      local cdeh_env_file_realpath=$(realpath_nolast $__cdeh_env_file)
      if [[ "$cdeh_env_file_realpath" == "$workspace_realpath"* ]]; then
        break
      fi
      cp "$__cdeh_env_file" "$HOME_AICLI/cdeh/env.host$nr"
      echo -e "# Copy of $__cdeh_env_file.\nsource \"\$CDEH_ROOT/env.host$nr\"" >> "$HOME_AICLI/env.source"
      nr=$((nr + 1))
    fi
  done
  echo "export DISPLAY=$AICLI_DISPLAY" >> "$HOME_AICLI/env.source"
  echo "export XAUTHORITY=$AICLI_XAUTHORITY" >> "$HOME_AICLI/env.source"
  IFS="$CDEH_SAVE_IFS"
}

# Included in the 'host' environement.
HOST_XAUTHORITY="$HOME/.Xauthority-xephyr"
AICLI_XAUTHORITY="$HOME_AICLI/.Xauthority-xephyr"
AICLI_DISPLAY=":100"

# Create $HOME_AICLI/env.source
__cdeh_restore_host_environment

#==============================================================================
# This should become a new service.

# Create netns nscodex (if it doesn't already exist).
echo "Starting nscodex netns."
sudo systemctl start netns-nft@nscodex.service

# Exit immediately if any command fails.
set -e

# End new service.
#==============================================================================

XEPHYR_BASE=$HOME_AICLI/.Xephyr
mkdir -p $XEPHYR_BASE
XEPHYR_PIDFILE="$XEPHYR_BASE/pid"
XEPHYR_COUNTFILE="$XEPHYR_BASE/refcount"
exec 9>"$XEPHYR_BASE/lock"

function start_xephyr()
{
  flock 9

  # Check if Xephyr is already running and pidfile is valid.
  xephyr_running=false
  if [ -f "$XEPHYR_PIDFILE" ]; then
    if read -r pid <"$XEPHYR_PIDFILE" && kill -0 "$pid" 2>/dev/null; then
      xephyr_running=true
    else
      # Stale pidfile.
      rm -f "$XEPHYR_PIDFILE"
    fi
  fi

  if ! $xephyr_running; then
    # Optional: additionally check for stale X socket if you like:
    #   [ -S "/tmp/.X11-unix/X${AICLI_DISPLAY#:}" ] && rm -f "/tmp/.X11-unix/X${AICLI_DISPLAY#:}"

    Xephyr "$AICLI_DISPLAY" -screen 1280x800 -br -nolisten tcp -auth "$HOST_XAUTHORITY" 2>/dev/null &
    sleep 1
    DISPLAY="$AICLI_DISPLAY" XAUTHORITY="$HOST_XAUTHORITY" fluxbox &
    xephyr_pid=$!
    printf '%s\n' "$xephyr_pid" >"$XEPHYR_PIDFILE"
    printf '1\n' >"$XEPHYR_COUNTFILE"
  else
    # Just bump the refcount.
    local count=0
    if [ -f "$XEPHYR_COUNTFILE" ]; then
      read -r count <"$XEPHYR_COUNTFILE" || count=0
    fi
    printf '%s\n' "$((count + 1))" >"$XEPHYR_COUNTFILE"
    echo "Xephyr already running! (refcount now $((count + 1)))."
  fi

  flock -u 9
}

function cleanup_xephyr()
{
  flock 9

  local count=0
  if [ -f "$XEPHYR_COUNTFILE" ]; then
    read -r count <"$XEPHYR_COUNTFILE" || count=0
  fi

  if [ "$count" -le 1 ]; then
    # We are the last user (or something went wrong and count was 0).
    if [ -f "$XEPHYR_PIDFILE" ]; then
      local pid
      read -r pid <"$XEPHYR_PIDFILE" || pid=""
      if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" || true
      fi
    fi
    rm -f "$XEPHYR_PIDFILE" "$XEPHYR_COUNTFILE"
  else
    printf '%s\n' "$((count - 1))" >"$XEPHYR_COUNTFILE"
    echo "NOT Killing Xephyr (refcount now $((count - 1)))."
  fi

  flock -u 9
}

function cleanup_nscodex()
{
  echo "NOT Removing nscodex netns."
  # Take down the nscodex netns.
  # Removing `lo` and/or `veth` also removes `nft`, which depends on it;
  # `name` is taken down because nobody is using it anymore.
#  sudo systemctl stop netns-lo@nscodex netns-veth@nscodex
  cleanup_xephyr
}

# Replace `/` characters with underscores.
function filenameify()
{
  local s=${1//\//_}
  printf '%s\n' "$s"
}

function start_sockettapd()
{
  local aicli_mode="$1"
  local name="$2"

  rm -f "$WORKSPACE_ROOT/sockettapd-$2.log"

  echo "Running: "\
 "sockettapd --planroot \"$PLANROOT\" --log \"$WORKSPACE_ROOT/sockettapd-$name.log\" --socket \"$name\""
  sockettapd --planroot "$PLANROOT"   --log "$WORKSPACE_ROOT/sockettapd-$name.log"   --socket "$name"
}

# Set trap for cleanup.
trap cleanup_nscodex EXIT ERR

# We don't have the host X11 from this environment.
unset XAUTHORITY

# Should be the same as ~/.bashrc.
export CDEH_ROOT=/opt/cdeh

# Helpers.
prepend_to_array() {
    local array_name="$1"
    shift
    local -n arr_ref="$array_name"  # nameref (bash 4.3+)
    arr_ref=("$@" "${arr_ref[@]}")
}

quote_args() {
  local quoted_args=()
  for arg in "$@"; do
    if [[ "$arg" =~ [[:space:]] ]]; then
      # Check if we can use single quotes (no single quotes in string).
      if [[ "$arg" != *"'"* ]]; then
        quoted_args+=("'$arg'")
      else
        # Use double quotes and escape all special chars.
        arg="${arg//\\/\\\\}"  # Escape backslashes first
        arg="${arg//\"/\\\"}"  # Escape double quotes
        arg="${arg//\$/\\\$}"  # Escape dollar
        arg="${arg//\`/\\\`}"  # Escape backticks
        # For other chars, we might need to escape them too.
        quoted_args+=("\"$arg\"")
      fi
    else
      quoted_args+=("$arg")
    fi
  done
  echo "${quoted_args[*]}"
}

quote_shell_words() {
  local quoted_args=()
  local arg=
  for arg in "$@"; do
    printf -v arg '%q' "$arg"
    quoted_args+=("$arg")
  done
  echo "${quoted_args[*]}"
}

add_ro () {  # Usage: add_ro SRC DST
  test -e "$1" && set -- "$@" "--ro-bind" "$1" "$1"
  printf '%s\0' "${@:2}"
}

# This command is run inside the container. It first generates ~/.codex/AGENTS.md before starting the CLI.
COMMAND="$HOME_AICLI/.local/bin/start_ai_cli"

# Determine AICLI_MODE and SESSION_ID.
AICLI_MODE=unknown
SESSION_ID=

if [ "$#" -eq 1 ] && [[ $1 == "shell" ]]; then
  # Run a bash shell with AICLI_MODE=shell.
  COMMAND="bash"
  AICLI_MODE="shell"
elif [ "$#" -ge 1 ] && [[ $1 == "bash" ]]; then
  # Run a command through bash inside the container.
  COMMAND="bash"
  AICLI_MODE="bash"
  shift
else
  # Process command line arguments and put them in `SESSION_ID` and/or `AICLI_MODE` respectively.
  while (($#)); do
    case "$1" in
      -s|resume)
        if (($# < 2)); then
          echo "Missing session ID after '$1'." >&2
          return 1
        fi
        SESSION_ID="$2"
        shift 2
        ;;
      *)
        AICLI_MODE="$1"
        shift
        ;;
    esac
  done
  # Try to deduce AICLI_MODE from SESSION_ID if the former wasn't specified on the command line.
  if [[ $AICLI_MODE == "unknown" && -n "$SESSION_ID" ]]; then
    local thread_id_dir="$PLANROOT/ThreadID/$SESSION_ID"
    if [[ -r "$thread_id_dir/mode" ]]; then
      # Figure out the mode.
      AICLI_MODE=$(<"$thread_id_dir/mode")
    else
      echo -e "\e[31mWARNING: $thread_id_dir DOES NOT EXIST!\e[0m"
      sleep 2
    fi
  fi
  # Try to deduce SESSION_ID from AICLI_MODE if the former wasn't specified on the command line.
  if [[ -z "$SESSION_ID" && -z ${AICLI_RUN_NEW_SESSION:-} && -L "$PLANROOT/$AICLI_MODE/id" ]]; then
    SESSION_ID=$(basename "$(readlink "$PLANROOT/$AICLI_MODE/id")")
  fi
fi

# Setup Agent Assisted Planner (AAP) project.
setup_aap
PLANBASE="$(basename "$PLANROOT")"

if [[ -n "$AICLI_RUN_OPENCODE" ]]; then
  echo "Running opencode..."
  # Construct command_args.
  if [[ $REPOBASE == "opencode" ]]; then
    command_args=(
      "/usr/bin/bun"
      "run"
      "dev"
      "--"
    )
  else
    command_args=(
      "opencode"
    )
  fi
else
  # Construct roots_json.
  if [[ $AICLI_MODE == "planner" ]]; then
    roots_json='["'$HOME_AICLI'/workspace/'$PLANBASE'"'
  elif [[ $AICLI_MODE == "coder" ]]; then
    roots_json='["'$HOME_AICLI'/workspace"'
  fi
  # Note: this won't work if GITACHE_ROOT, CCACHE_DIR or HOME contain spaces or quotes.
  # Also note that $HOME/.ssh will be mapped onto $HOME_AICLI/.ssh -- it isn't the real HOME.
  for p in "${GITACHE_ROOT}" "${CCACHE_DIR}" "${HOME}/.ssh" "${AICLI_EXTRA_WRITABLE_ROOTS[@]}"; do
    roots_json+=",\"$p\""
  done
  roots_json+="]"

  # Determine which command to run.
  del_path $HOME/bin      # Do not run the codex script (again), if that exists.
  CODEX_COMMAND="$(/usr/bin/which codex | sed -e 's%'$WORKSPACE_ROOT'%'$HOME_AICLI'/workspace%')"
  echo "CODEX_COMMAND = $CODEX_COMMAND"

  # Construct command_args.
  command_args=(
    "$CODEX_COMMAND"
  #  "--sandbox" "workspace-write"                                 # `workspace` here refers to the repository - not workspace/.
    "--sandbox" "danger-full-access"
    # These options are only OK inside this container:
    "--ask-for-approval" "never"
    "--config" "sandbox_workspace_write.network_access=true"
    "--config" "sandbox_workspace_write.writable_roots=${roots_json}"
  )
fi
if [[ $AICLI_MODE == "shell" ]]; then
  command_args=("-l")
elif [[ $AICLI_MODE == "bash" ]]; then
  command_args=("-lc" "$(quote_shell_words "$@")")
elif [[ -n "$SESSION_ID" ]]; then
  if [[ -n "$AICLI_RUN_OPENCODE" ]]; then
    command_args+=(-s "$SESSION_ID")
    if [[ $AICLI_MODE != "unknown" ]]; then
      command_args+=(--agent "$AICLI_MODE")
    fi
  else
    command_args+=(resume "$SESSION_ID")
  fi
else
  if [[ -n "$AICLI_RUN_OPENCODE" ]]; then
    if [[ $AICLI_MODE != "unknown" ]]; then
      command_args+=(--agent "$AICLI_MODE")
    fi
  fi
fi

# Build the bwrap argv tail (the --ro-bind pieces).
ETC_FILES=()
mapfile -d '' -t ETC_FILES < <(
  add_ro /etc/passwd
  add_ro /etc/group
  add_ro /etc/nsswitch.conf
  add_ro /etc/hosts
  add_ro /etc/localtime
  add_ro /etc/ld.so.cache
  add_ro /etc/ssl
  add_ro /etc/ca-certificates
  add_ro /etc/remountd
  add_ro /etc/fonts
  echo -n
)

# Recreate the /usr/src/linux symlink in case the kernel version changed since the last run.
sudo ln -sf "../lib/modules/$(uname -r)/build" "$HOME_AICLI/.bwrap-masks/usr_src_linux/linux"

# Start a pseudo X server. This creates a UNIX socket /tmp/.X11-unix/X100
start_xephyr

if [[ -n "$AICLI_RUN_OPENCODE" ]]; then
  AGENT="opencode"
else
  AGENT="codex"
fi
echo -e "Running $AGENT in \e[31m\"$AICLI_MODE\" mode\e[0m."

if [[ $AICLI_MODE != "bash" && $AICLI_MODE != "shell" ]]; then
  # Start the sockettapd.
  killall sockettapd || true
  start_sockettapd "$AICLI_MODE" "$(filenameify "$REPOBASE")"
  # Make the agent listen on the correct socket.
  if [[ -z "$AICLI_RUN_OPENCODE" ]]; then
    command_args+=(--config exec_socket_path="$HOME_AICLI/workspace/$PLANBASE/$AICLI_MODE.sock")
  fi
  # Note that for opencode we no longer use branch CW02-sockettap, but use plugin `session_id.js` instead.
  #command_args+=(--exec-socket-path "$HOME_AICLI/workspace/$PLANBASE/$AICLI_MODE.sock")
fi

# Switch home directories.
HOME_USER="$HOME"
HOME="$HOME_AICLI"

# Set up cdeh; this must be the same as what is used in $HOME_AICLI/.bash_profile
AICLI_CDEH_ROOT=$HOME/cdeh
# In case it changed.
cp $CDEH_ROOT/env.bashrc $AICLI_CDEH_ROOT
cp $CDEH_ROOT/do_prompt $AICLI_CDEH_ROOT

mode_of ()
{
  stat -L -c '%a' -- "$1" 2>/dev/null || echo "755"
}

create_dirs ()
{
  local path="$1"
  local stop_at="${2:-/}"
  local -a dirs=()
  local d=

  while :; do
    path=$(dirname -- "$path") || return 1
    [[ "$path" == "$stop_at" ]] && break
    dirs=("$path" "${dirs[@]}")
  done

  for d in "${dirs[@]}"; do
    printf -- '--perms %s --dir %s\n' "$(mode_of "$d")" "$d"
  done
}

# The arguments passed to bwrap.
bwrap_args=(
  # Mount directories required for the Operating System.
  --proc /proc
  --dev /dev
  $(create_dirs /sys/devices/system/cpu) --ro-bind /sys/devices/system/cpu /sys/devices/system/cpu     # Needed to determine config::cacheline_size_c (utils).
  --perms $(mode_of /tmp) --tmpfs /tmp
  --perms 755 --dir /tmp/.X11-unix
  --ro-bind /tmp/.X11-unix /tmp/.X11-unix
  --ro-bind /usr /usr
  --ro-bind /bin /bin
  --ro-bind /lib /lib
  --ro-bind-try /lib64 /lib64
  # Mount an empty /etc with just a resolv.conf and profile.
  --bind "$HOME_AICLI/.bwrap-masks/etc" /etc                    # We need to use --bind for the next line to work, then remount it ro.
  # Add remaining /etc files to it.
  "${ETC_FILES[@]}"
  --remount-ro /etc
  $(create_dirs /run/remountd) --bind /run/remountd /run/remountd
  --bind /run/netns /run/netns
  # Mount an empty /usr/src with a linux symlink.
  --bind "$HOME_AICLI/.bwrap-masks/usr_src_linux" /usr/src      # We need to use --bind for the next line to work, then remount it to.
  # Add a nvim plugin to that that we're symlinking.
  $(create_dirs /usr/src/pathogen/vim-pathogen/autoload/pathogen.vim /usr/src)
  --ro-bind "/usr/src/pathogen/vim-pathogen/autoload/pathogen.vim" "/usr/src/pathogen/vim-pathogen/autoload/pathogen.vim"
  --remount-ro /usr/src
  # Mount the home directory; the CLI should never write here, therefore it is remounted ro below.
  $(create_dirs "$HOME_AICLI") --bind "$HOME_AICLI" "$HOME_AICLI"
  # ssh doesn't use HOME, so we have to add HOME_USER to the container. We need mode 755 because it will be owned by root inside the container.
  --perms 755 --dir "$HOME_USER"
  # Use --bind so we can add to /home/carlo/.ssh/known_hosts from the shell. Other files are owned by root.
  $(create_dirs "$HOME_USER/.ssh") --bind "$HOME_AICLI/.ssh" "$HOME_USER/.ssh"
  # Add individual directories from our home directory.
  $(create_dirs "$HOME_AICLI/.config/nvim" "$HOME_AICLI") --ro-bind "$HOME_USER/.config/nvim" "$HOME_AICLI/.config/nvim"
  $(create_dirs "$HOME_USER/projects/github/neovim-true-color-scheme-editor" "$HOME_USER")
  --ro-bind "$HOME_USER/projects/github/neovim-true-color-scheme-editor" "$HOME_USER/projects/github/neovim-true-color-scheme-editor"
  --ro-bind "$HOST_XAUTHORITY" "$AICLI_XAUTHORITY"
  # Only really needed for the Codex CLI, but well.
  --bind "$HOME_USER/.codex" "$HOME_AICLI/.codex"
  # Mount the whole workspace as read-only.
  #FIXME --ro-bind "$WORKSPACE_ROOT" "$HOME_AICLI/workspace"
  --bind "$WORKSPACE_ROOT" "$HOME_AICLI/workspace"
  # Use a file that resides in this project as .bash_profile in the container.
  --ro-bind "$HOME_USER/projects/github/ai-cli/ai-cli-bwrap/dot-bash_profile" "$HOME_AICLI/.bash_profile"
  # Remount $HOME_AICLI read-only, now that all bind mounts have been added to it.
  --remount-ro "$HOME_AICLI"
  # The CLI needs write access to the gitache root.
  --bind "$GITACHE_ROOT" "$GITACHE_ROOT"
  --perms $(mode_of /tmp) --tmpfs "$CCACHE_DIR"
)

if [[ -n "$AICLI_RUN_OPENCODE" ]]; then
  bwrap_args+=(
    # This must be read-write because this directory is written to by multiple applications;
    # it contains contains XDG_CACHE_HOME, OpenCode's SQLite DB in XDG_DATA_HOME and XDG_CONFIG_HOME is
    # where the global AGENTS.md is being generated.
    --bind "$AICLI_XDG_ROOT" "$HOME_AICLI/workspace/.xdg"
  )
fi

if [[ $AICLI_MODE == "analyst" || $AICLI_MODE == "planner" ]]; then
  if [[ $AICLI_MODE == "planner" ]]; then
    bwrap_args+=(
      # Mount the PLANROOT read-write.
      --bind "$WORKSPACE_ROOT/$PLANBASE" "$HOME_AICLI/workspace/$PLANBASE"
    )
  fi
  bwrap_args+=(
    # Change directory to the PLANROOT repository.
    --chdir "$HOME_AICLI/workspace/$PLANBASE"
  )
else
  CLEAN_CWD=$(realpath --no-symlinks "$HOME_AICLI/workspace/$REPOBASE/$AICLI_DIRECTORY")
  bwrap_args+=(
    # Mount the REPOROOT read-write.
    --bind "$WORKSPACE_ROOT/$REPOBASE" "$HOME_AICLI/workspace/$REPOBASE"
    # Change directory to the REPOROOT repository.
    --chdir "$CLEAN_CWD"
  )
fi

export HOME REPOBASE AICLI_MODE AICLI_RUN_OPENCODE

echo "HOME=\"$HOME\""
echo "REPOBASE=\"$REPOBASE\""
echo "AICLI_MODE=\"$AICLI_MODE\""
echo "AICLI_RUN_OPENCODE=\"$AICLI_RUN_OPENCODE\""

echo "Starting bwrap, command:"
echo "sudo --preserve-env=HOME,REPOBASE,AICLI_MODE,AICLI_RUN_OPENCODE \\"
echo "  ip netns exec nscodex \\"
echo "    bwrap $(quote_args "${bwrap_args[@]}") \\"
echo "      -- \\"
echo "      setpriv --reuid 1000 --regid 1000 --groups 1000,remountd \\"
echo "        $COMMAND $(quote_args "${command_args[@]}")"

sudo --preserve-env=HOME,REPOBASE,AICLI_MODE,AICLI_RUN_OPENCODE \
  ip netns exec nscodex \
    bwrap "${bwrap_args[@]}" \
      -- \
      setpriv --reuid 1000 --regid 1000 --groups 1000,remountd \
        "$COMMAND" "${command_args[@]}"
