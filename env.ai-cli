# If this happens there is a problem. Unset WORKSPACE_ROOT then source ~/.bashrc.
test -z "${WORKSPACE_ROOT:-}" || echo "~/projects/env.ai-cli: warning: WORKSPACE_ROOT is part of env.base"

# The "home" directory of the CLI.
HOME_AICLI="/opt/ext4/nvme2/codex"
# Where to find the global codex configuration.
CODEX_HOME="$HOME/.codex"

function ai_cli()
{
  # Save the original positional parameters.
  local original_args=()
  local run_opencode=0
  local run_new_session=0

  for arg in "$@"; do
    if [[ "$arg" == "--opencode" ]]; then
      run_opencode=1
      continue
    fi
    if [[ "$arg" == "--new-session" ]]; then
      run_new_session=1
      continue
    fi
    original_args+=("$arg")
  done

  (
    # Set positional parameters for the sourced script.
    set -- "${original_args[@]}"

    if [[ $run_opencode -eq 1 ]]; then
      AICLI_RUN_OPENCODE=1
    fi

    if [[ $run_new_session -eq 1 ]]; then
      AICLI_RUN_NEW_SESSION=1
    fi

    # Run the CLI. Note that CODEX_HOME must still be set when running `codex`:
    # this function must be run from an interactive shell.
    source "$HOME/projects/github/ai-cli/ai-cli-bwrap/ai-cli.run"
  )
  local exit_code=$?

  # Handle exit codes from the subshell
  if [[ $exit_code -ne 0 ]]; then
    echo "ai-cli.run failed with exit code: $exit_code" >&2
    return $exit_code
  fi
}

__opencode_usage() {
  cat >&2 <<'EOF'
Usage:
  opencode shell
  opencode bash [args...]
  opencode pure
  opencode [new | resume <session-id> | -s <session-id>] [analyst | planner | coder]
EOF
}

__opencode_normalize_session_id() {
  local session_id="$1"
  session_id="${session_id%/}"
  [[ -n "$session_id" ]] || return 1
  basename -- "$session_id"
}

__opencode_mode_for_session() {
  local session_id="$1"
  local mode_file="$PLANROOT/ThreadID/$session_id/mode"
  local mode=

  [[ -r "$mode_file" ]] || return 1
  IFS= read -r mode < "$mode_file" || return 1
  case "$mode" in
    analyst|planner|coder)
      printf '%s\n' "$mode"
      return 0
      ;;
  esac
  return 1
}

__opencode_session_for_mode() {
  local mode="$1"
  local link="$PLANROOT/$mode/id"
  local target=

  [[ -L "$link" ]] || return 1
  target=$(readlink "$link") || return 1
  __opencode_normalize_session_id "$target"
}

__opencode_last_session_id() {
  local mode=
  local link=
  local mtime=
  local best_mode=
  local best_mtime=-1

  for mode in analyst planner coder; do
    link="$PLANROOT/$mode/id"
    [[ -L "$link" ]] || continue
    mtime=$(stat -c %Y -- "$link" 2>/dev/null) || continue
    if [[ -z "$best_mode" || "$mtime" -gt "$best_mtime" ]]; then
      best_mode="$mode"
      best_mtime="$mtime"
    fi
  done

  [[ -n "$best_mode" ]] || return 1
  __opencode_session_for_mode "$best_mode"
}

__opencode_launch() {
  local mode="$1"
  local session_id="$2"

  echo "Running __opencode_launch $mode $session_id"

  if [[ -z $session_id ]]; then
    ai_cli --opencode "$mode"
  elif [[ $session_id == "new" ]]; then
    ai_cli --opencode "$mode" --new-session
  else
    ai_cli --opencode "$mode" resume "$session_id"
  fi

  return $?
}

function opencode()
{
  local action=
  local session_id=
  local explicit_mode=
  local mode=

  # Invocation:
  #
  #   opencode shell
  #
  # Starts an interactive shell inside the container.
  if [[ "$#" -eq 1 && "$1" == "shell" ]]; then
    # Implemented by the function `ai_cli`.
    ai_cli --opencode shell
    return $?
  fi

  # Invocation:
  #
  #   opencode bash <command> [args...]
  #
  # Runs <command> [args...] inside the container and exits.
  if [[ "$#" -ge 1 && "$1" == "bash" ]]; then
    shift
    # Implemented by the function `ai_cli`.
    ai_cli --opencode bash "$@"
    return $?
  fi

  # Invocation:
  #
  #   opencode pure
  #
  # Starts opencode with OPENCODE_PURE=1.
  if [[ "$#" -eq 1 && "$1" == "pure" ]]; then
    # Implemented by the function `ai_cli`.
    ai_cli --opencode pure
    return $?
  fi

  echo "Running opencode $@"

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      new)
        if [[ -n "$action" ]]; then
          __opencode_usage
          return 2
        fi
        action="new"
        ;;
      resume|-s)
        if [[ -n "$action" || "$#" -lt 2 ]]; then
          __opencode_usage
          return 2
        fi
        action="resume"
        session_id="$2"
        shift
        ;;
      analyst|planner|coder)
        if [[ -n "$explicit_mode" ]]; then
          __opencode_usage
          return 2
        fi
        explicit_mode="$1"
        ;;
      *)
        __opencode_usage
        return 2
        ;;
    esac
    shift
  done

  if [[ -n "$session_id" ]]; then
    session_id=$(__opencode_normalize_session_id "$session_id") || {
      echo "opencode: invalid session id" >&2
      return 2
    }
  fi

  if [[ -z "$action" && -z "$session_id" ]]; then
    if [[ -n "$explicit_mode" ]]; then
      session_id=$(__opencode_session_for_mode "$explicit_mode" || true)
    fi
    if [[ -z "$session_id" ]]; then
      session_id=$(__opencode_last_session_id 2>/dev/null || true)
    fi
  fi

  if [[ -n "$explicit_mode" ]]; then
    mode="$explicit_mode"
  elif [[ -n "$session_id" ]]; then
    mode=$(__opencode_mode_for_session "$session_id" 2>/dev/null) || mode="unknown"
  fi

  [[ -n "$mode" ]] || mode="coder"
  [[ $action != "new" ]] || session_id=new

  # mode: agent-name.
  __opencode_launch "$mode" "$session_id"
}
